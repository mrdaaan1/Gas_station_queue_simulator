# Unity: служебные папки, которые Unity пересоздаёт сам — их НЕ храним в Git
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Файлы IDE (Visual Studio, Rider, VS Code)
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Сборки и краш-логи
*.apk
*.aab
*.unitypackage
sysinfo.txt
crashlytics-build.properties

# Системный мусор
.DS_Store
Thumbs.db
desktop.ini

# Сборка симулятора и просмотрщика моделей
Tools/**/bin/
Tools/**/obj/
Tools/**/node_modules/
!Tools/**/*.csproj

# Материалы, которые редактор сохраняет перед сборкой (свои для каждого проекта)
/Assets/Resources/GasQueueGenerated/
/Assets/Resources/GasQueueGenerated.meta

# Своя музыка для «Гонка FM» — только локально (чужие треки нельзя выкладывать)
/Assets/Resources/RaceMusic/*
!/Assets/Resources/RaceMusic/README.txt
!/Assets/Resources/RaceMusic/README.txt.meta
# Озвучка радио голосами macOS (Tools/make_radio_news.sh) — только для себя
/Assets/Resources/RadioNews/*
!/Assets/Resources/RadioNews/README.txt
!/Assets/Resources/RadioNews/README.txt.meta
